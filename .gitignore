# =========================
# 项目约定忽略（工作数据 / 个人配置 / 上传 / 临时）
# =========================
.workbuddy/
.env
public/uploads/
*.bak*
*.tmp
# tools/pack_server.js 的部署包产物
/dist/
# 运行时生成的数据（saveInfo 接口写入，勿入库；部署时自动创建）
/backend/data/users.json
# 未引用的旧素材 / 构建缓存（保留本地磁盘，不进仓库）
/audio/
/unpackage/

# =========================
# 敏感文件（绝对禁止入库）
# =========================
# 签名密钥（APK 发布凭证，丢失无法更新已上架应用）
/keystore/
*.jks
*.keystore
*.p12

# 运行时配置文件（含环境变量、数据库连接等）
*.local
!/*.example



